# Server
PORT=4000
NODE_ENV=development

# Groq (never commit real keys — put them only in local .env)
GROQ_API_KEY=your_new_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MAX_COMPLETION_TOKENS=1600
GROQ_TIMEOUT_MS=25000
GROQ_MAX_RETRIES=2

# Postgres (optional — omit to use in-memory interview store)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/devsim

# Cost / abuse controls
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
MAX_EVALUATE_ATTEMPTS=8
MAX_ANSWER_ATTEMPTS=6
